    <a href="#" class="social-btn" title="Dribbble">&#127944;</a>
  </div>
</footer>

<script>
  function handleSubmit(e) {
    e.preventDefault();
    var btn = e.target.querySelector('.btn-submit');
    btn.textContent = 'Message envoye !';
    btn.style.background = '#3A7A5C';
    setTimeout(function() {
      btn.textContent = 'Envoyer le message';
      btn.style.background = '';
      e.target.reset();
    }, 3000);
  }

  var sections = document.querySelectorAll('section[id]');
  var links = document.querySelectorAll('.nav-links a');
  window.addEventListener('scroll', function() {
    var current = '';
    sections.forEach(function(s) { if (window.scrollY >= s.offsetTop - 120) current = s.id; });
    links.forEach(function(a) { a.style.color = a.getAttribute('href') === '#' + current ? 'var(--ink)' : ''; });
  });
</script>
</body>
</html>